{
  "stdio_services": {
    "mcp-model-proxy-assistant": {
      "description": "MCP Model Proxy Assistant - STDIO service",
      "container_name": "mcp-model-proxy-assistant",
      "image": "localhost/mcp-model-proxy-assistant:latest",
      "managed_by": "stdio",
      "stack": "mcp-services-stack",
      "run_command": "podman run --rm -i --network=host -e MODEL_PROXY_URL=http://localhost:8002 localhost/mcp-model-proxy-assistant:latest",
      "dockerfile_path": "/home/pwp/srv/coding_agent/mcp/mcp-model-proxy-assistant/Dockerfile.mcp-model-proxy-assistant",
      "notes": "Runs via podman with --rm flag, not managed by systemd"
    },
    "mcp-git-tools": {
      "description": "MCP Git Tools - STDIO service",
      "container_name": "mcp-git-tools",
      "image": "localhost/mcp-git-tools:latest",
      "managed_by": "stdio",
      "stack": "mcp-services-stack",
      "run_command": "/home/pwp/srv/coding_agent/mcp/mcp-git-tools",
      "dockerfile_path": "/home/pwp/srv/coding_agent/mcp/mcp-git-tools/Dockerfile.mcp-git-tools",
      "notes": "Direct executable STDIO service, not containerized"
    }
  },
  "detection_patterns": {
    "container_name_patterns": [
      "^mcp-.*-assistant$",
      "^mcp-git-tools$"
    ],
    "image_patterns": [
      "localhost/mcp-.*-assistant:.*",
      "localhost/mcp-git-tools:.*"
    ]
  }
}
